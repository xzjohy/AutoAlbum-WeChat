<view class="page">
  <view class="hero device-hero">
    <view class="eyebrow">BLE LINK</view>
    <view class="hero-title">设备连接</view>
    <view class="hero-sub">发现并验证 S24 墨水屏</view>
    <view class="connection {{connected ? 'online' : ''}}"><view class="dot"></view>{{connected ? '链路已建立' : '等待连接'}}</view>
  </view>
  <view class="panel">
    <view class="row">
      <view><view class="panel-title">{{connected ? 'S24 墨水屏' : '附近设备'}}</view><view class="muted">{{connected ? deviceId : '请在手机微信中搜索'}}</view><view class="firmware-version" wx:if="{{connected}}">固件版本：{{firmwareVersion || '旧固件未提供'}}</view></view>
      <view class="signal {{connected ? 'active' : ''}}"><view></view><view></view><view></view></view>
    </view>
    <view class="status" wx:if="{{screenStatus}}">{{screenStatus}}</view>
    <button class="tech-btn" wx:if="{{!connected}}" disabled="{{connecting}}" bindtap="scan">{{scanning ? '重新扫描' : '扫描 BLE 设备'}}</button>
    <button class="tech-btn disconnect" wx:else bindtap="disconnect">断开连接</button>
  </view>
  <view class="panel connection-policy">
    <view class="panel-title">蓝牙空闲自动断开</view>
    <view class="muted">设备空闲达到设定时间后自动释放连接。</view>
    <view class="policy-row"><text>断开时间</text><view class="interval-input"><input type="number" value="{{idleDisconnectDraft}}" disabled="{{connecting}}" bindinput="inputIdleDisconnect"/><text>分钟</text></view></view>
    <view class="muted">可设置 0–999 分钟；0 表示保持连接，离开小程序时仍会主动释放蓝牙。</view>
    <button class="tech-btn ghost" disabled="{{!connected || connecting}}" loading="{{connecting}}" bindtap="applyIdleDisconnect">应用断开策略</button>
  </view>
  <view class="panel" wx:if="{{!connected}}">
    <view class="scan-line" wx:if="{{scanning}}"></view>
    <view class="hint" wx:if="{{scanning && !devices.length}}">正在监听蓝牙广播，请让墨水屏靠近手机。</view>
    <view wx:for="{{devices}}" wx:key="deviceId" class="device {{item.isScreen ? 'screen' : ''}}" bindtap="connect" data-id="{{item.deviceId}}">
      <view class="device-icon">{{item.isScreen ? 'EP' : 'BT'}}</view>
      <view class="device-main"><view class="device-name">{{item.displayName}}<text class="screen-tag" wx:if="{{item.isScreen}}">匹配</text></view><view class="muted device-id">{{item.deviceId}}</view></view>
      <view class="rssi">{{item.RSSI}}<text>dBm</text></view>
    </view>
  </view>
</view>

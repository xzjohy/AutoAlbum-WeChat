.device{padding:24rpx 0;border-bottom:1rpx solid #eee}.device:last-child{border-bottom:0}
.clock-choice{display:flex;gap:16rpx;margin:20rpx 0}.clock-choice button{flex:1}.clock-active{font-weight:700;border:3rpx solid currentColor}.clock-interval{display:flex;align-items:center;justify-content:space-between;margin:24rpx 0 8rpx}.clock-interval input{width:180rpx;text-align:center;border:1rpx solid #ddd;border-radius:12rpx;padding:14rpx}

.clock-preview-tabs{display:flex;gap:16rpx;margin:20rpx 0}.clock-preview-card{flex:1;padding:12rpx;border:3rpx solid transparent;border-radius:16rpx;text-align:center}.clock-preview-card.clock-active{font-weight:700;border-color:currentColor}.clock-preview-image{display:block;width:100%;height:220rpx;margin-bottom:10rpx;border:1rpx solid #ddd;border-radius:8rpx;background:#fff}

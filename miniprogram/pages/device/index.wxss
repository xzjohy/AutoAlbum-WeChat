.device-hero{background:radial-gradient(circle at 85% 10%,rgba(37,207,218,.24),transparent 40%),linear-gradient(145deg,#0f1b2b,#0a1521)}.signal{display:flex;align-items:flex-end;gap:6rpx;height:48rpx}.signal>view{display:block;width:8rpx;border-radius:8rpx;background:#344657}.signal>view:nth-child(1){height:16rpx}.signal>view:nth-child(2){height:28rpx}.signal>view:nth-child(3){height:42rpx}.signal.active>view{background:#2cddc7;box-shadow:0 0 12rpx rgba(44,221,199,.5)}.disconnect{background:linear-gradient(135deg,#79394f,#522947)!important;border-color:#9d4b70!important}.device{display:flex;align-items:center;gap:18rpx;padding:22rpx 4rpx;border-bottom:1rpx solid #1c2b3b}.device:last-child{border-bottom:0}.device.screen{margin:6rpx -10rpx;padding:22rpx 14rpx;border:1rpx solid #1d8791;border-radius:18rpx;background:rgba(23,137,148,.1)}.device-icon{width:70rpx;height:70rpx;line-height:70rpx;text-align:center;border-radius:18rpx;background:#162636;color:#7692a7;font-size:22rpx;font-weight:800}.screen .device-icon{color:#4be1e9;background:#123943}.device-main{min-width:0;flex:1}.device-name,.device-id{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.screen-tag{font-size:18rpx;color:#46e1d8;background:#173f45;border-radius:999rpx;padding:4rpx 10rpx;margin-left:10rpx}.rssi{color:#92a7b8;font-size:26rpx}.rssi text{display:block;font-size:18rpx}.hint{padding:30rpx 10rpx;text-align:center;color:#758a9e;font-size:24rpx}.scan-line{height:2rpx;background:linear-gradient(90deg,transparent,#2de0eb,transparent);box-shadow:0 0 18rpx #24d2df;animation:scan 1.8s infinite}@keyframes scan{0%{opacity:.2;transform:translateY(0)}50%{opacity:1}100%{opacity:.2;transform:translateY(100rpx)}}
.device-name{font-size:28rpx}.device-id{font-size:22rpx}
.firmware-version{margin-top:10rpx;color:#55dce5;font-size:22rpx}
.connection-policy{font-size:26rpx}.policy-row{min-height:88rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx;border-bottom:1rpx solid #1e3040}.policy-row .interval-input{display:flex;align-items:center;gap:10rpx;color:#8ca4b6;font-size:23rpx}.policy-row input{width:112rpx;height:62rpx;text-align:center;border:1rpx solid #2a5063;border-radius:14rpx;background:#09131f;color:#4be0e9;font-size:27rpx}

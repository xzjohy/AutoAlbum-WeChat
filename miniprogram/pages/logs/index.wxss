.log-hero{background:radial-gradient(circle at 88% 5%,rgba(90,69,184,.26),transparent 42%),linear-gradient(145deg,#111929,#111326)}.toolbar{padding:8rpx 4rpx 24rpx}.clear-btn{background:#131f2d!important;color:#7edee5!important;border:1rpx solid #275064!important;border-radius:999rpx!important}.log-entry{display:flex;position:relative;gap:20rpx;padding:0 0 26rpx 8rpx}.log-entry:before{content:"";position:absolute;left:16rpx;top:28rpx;bottom:-4rpx;width:1rpx;background:#243548}.log-entry:last-child:before{display:none}.timeline-dot{position:relative;z-index:1;width:16rpx;height:16rpx;margin-top:20rpx;border-radius:50%;background:#36d8e1;box-shadow:0 0 12rpx rgba(54,216,225,.5)}.timeline-dot.WARN{background:#f1b657}.timeline-dot.ERROR{background:#ef6687}.log-body{flex:1;min-width:0;background:#0e1926;border:1rpx solid #1c2d3e;border-radius:17rpx;padding:20rpx}.level{font-size:19rpx;color:#38d9e3;margin-right:12rpx}.tag{font-size:23rpx;color:#9db0bf}.time{font-size:18rpx;color:#53697b;max-width:300rpx;overflow:hidden}.message{margin-top:10rpx;color:#d2e2ec;font-size:24rpx;word-break:break-all}.empty-log{text-align:center;color:#657b8f;padding:100rpx 0}
.clear-btn{font-size:24rpx!important}.tag{font-size:24rpx}.message{font-size:25rpx}

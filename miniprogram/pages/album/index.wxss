.slot{padding:20rpx 0;border-bottom:1rpx solid #eee}.slot:last-child{border-bottom:0}.slot-head,.slot-body,.interval-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.slot-title{font-weight:600}.preview{width:220rpx;height:165rpx;background:#f3f3f3;border-radius:14rpx}.preview.empty{display:flex;align-items:center;justify-content:center;color:#999;font-size:24rpx}.slot-actions{flex:1;display:flex;flex-wrap:wrap;align-items:center;gap:12rpx}.slot-actions button{margin:0}.status{width:100%;font-size:24rpx;color:#666}.interval-row{margin:24rpx 0}.interval-row input{width:180rpx;text-align:right;background:#f5f5f5;padding:12rpx 16rpx;border-radius:10rpx}.sync-box{margin-top:22rpx}.sync-box progress{margin:18rpx 0}

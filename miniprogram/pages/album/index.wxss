.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:22rpx}.photo{position:relative;height:190rpx;background:#eee;border-radius:14rpx;overflow:hidden}.photo image{width:100%;height:100%}.photo text{position:absolute;right:8rpx;bottom:8rpx;background:rgba(255,255,255,.85);padding:2rpx 10rpx;border-radius:12rpx;font-size:22rpx}
.album-hero{background:radial-gradient(circle at 92% 8%,rgba(29,205,222,.24),transparent 38%),linear-gradient(145deg,#101b2a,#0a121e)}.mode-tabs{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10rpx;margin-bottom:24rpx;background:#0d1724;padding:8rpx;border-radius:18rpx;border:1rpx solid #1d3044}.mode-tab{height:76rpx!important;padding:0 8rpx!important;font-size:26rpx!important;background:transparent!important;color:#71869a!important;border:0!important}.mode-tab.active{background:linear-gradient(135deg,#123e50,#155a68)!important;color:#eaffff!important;box-shadow:inset 0 0 0 1rpx #28c9d8}.mode-tab text{display:block;font-size:20rpx}.counter{width:64rpx;height:64rpx;line-height:64rpx;text-align:center;border-radius:18rpx;background:#102637;color:#2dd9e6;font-weight:700}.empty{text-align:center;padding:56rpx 0;color:#a6b8c6;font-size:27rpx}.empty-icon{font-size:70rpx;color:#27d1df;margin-bottom:12rpx}.photo-strip{white-space:nowrap;margin:28rpx 0}.photo{display:inline-block;position:relative;width:230rpx;height:172rpx;margin-right:16rpx;border-radius:18rpx;overflow:hidden;border:2rpx solid #203449;background:#09111d}.photo.selected{border-color:#2de0dc;box-shadow:0 0 24rpx rgba(45,224,220,.35)}.photo image{width:100%;height:100%}.photo text{position:absolute;right:10rpx;bottom:10rpx;background:rgba(5,12,20,.8);color:#67e9ef;padding:4rpx 12rpx;border-radius:999rpx;font-size:21rpx}.settings-panel{padding-top:8rpx;padding-bottom:8rpx}.setting-row{min-height:112rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #1c2b3b;font-size:27rpx}.settings-panel picker:last-child .setting-row,.settings-panel>.setting-row:last-child{border-bottom:0}.select-value{color:#36d6e2}.progress-panel{font-size:27rpx}.percent{color:#36dae4;font-weight:700}.progress-track{height:12rpx;background:#080f19;border-radius:999rpx;overflow:hidden;margin-top:18rpx}.progress-fill{height:100%;background:linear-gradient(90deg,#1bc6df,#4ce0bc);box-shadow:0 0 16rpx #28d3df}.stop{background:linear-gradient(135deg,#93415e,#603163)!important;border-color:#c25a84!important}.text-btn{background:transparent!important;color:#74899c!important;font-size:26rpx!important}
.file-btn{margin-top:14rpx!important;background:#111d2b!important;border-color:#315169!important;color:#a9d9e5!important;box-shadow:none!important}.interval-setting{border-bottom:0}.interval-input{display:flex;align-items:center;gap:10rpx;color:#7f98aa}.interval-input input{width:120rpx;height:66rpx;text-align:center;border:1rpx solid #2a5063;border-radius:14rpx;background:#09131f;color:#4be0e9;font-size:28rpx}.preset-row{display:grid;grid-template-columns:repeat(5,1fr);gap:8rpx;padding:18rpx 0}.preset-row button{height:62rpx!important;line-height:62rpx!important;padding:0!important;border-radius:14rpx!important;background:#101e2c!important;color:#7fb3c2!important;border:1rpx solid #263f52!important;font-size:20rpx!important}.preset-row button:after{border:0}
.mode-control{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.mode-control>view{flex:1}
.edit-panel{font-size:27rpx}.mini-action{margin:0!important;height:62rpx!important;line-height:62rpx!important;padding:0 22rpx!important;border-radius:14rpx!important;background:#132a3a!important;color:#62e2e9!important;border:1rpx solid #286174!important;font-size:24rpx!important}.mini-action:after{border:0}.gray-row{display:flex;justify-content:space-between;margin-top:28rpx;color:#b8cbd6;font-size:25rpx}.format-hint{color:#6f879a;font-size:23rpx;line-height:1.55}
.photo.playing{border-color:#9b84ff;box-shadow:0 0 26rpx rgba(155,132,255,.55)}

.conversion-canvas{position:fixed;left:-1000px;top:0;width:400px;height:300px;pointer-events:none}.conversion-actions{display:flex;gap:16rpx;margin:24rpx 0}.converted-preview{margin-top:24rpx}.converted-preview image{width:100%;height:450rpx;background:#fff;border-radius:12rpx}
.stop-upload{width:100%;height:72rpx!important;line-height:72rpx!important;margin-top:22rpx!important;border-radius:14rpx!important;background:linear-gradient(135deg,#8b3d57,#572a46)!important;border:1rpx solid #ca6686!important;color:#fff1f4!important;font-size:25rpx!important}
.connection-required{margin:24rpx 0;padding:22rpx 24rpx;border:1rpx solid #496074;border-radius:16rpx;background:#102031;color:#afc1cf;font-size:24rpx;display:flex;align-items:center;justify-content:space-between;gap:18rpx}.connection-required button{margin:0!important;height:58rpx!important;line-height:58rpx!important;padding:0 20rpx!important;border-radius:999rpx!important;background:#1f6174!important;color:#efffff!important;font-size:23rpx!important}

<view class="page"><view class="card"><view class="row"><view><view class="title">自动相册</view><view class="muted">BW · BWR · BWY 墨水屏</view></view><view class="badge">{{connected?'已连接':'未连接'}}</view></view></view><view class="card"><view class="row"><text>我的相册</text><text class="muted">{{images.length}} 张</text></view><view class="grid"><view class="photo" wx:for="{{images}}" wx:key="path"><image src="{{item.path}}" mode="aspectFill"/><text>{{index+1}}</text></view></view><button class="btn" bindtap="chooseImages">＋ 添加图片</button><button class="btn" type="primary" disabled="{{!images.length||syncing}}" bindtap="sync">{{syncing?'同步中 '+progress+'%':'同步到墨水屏'}}</button><button class="btn" wx:if="{{images.length}}" bindtap="clear">清空相册</button></view><view class="card"><view>API 图片</view><view class="muted">API 下载/批量导入接口已预留，下一阶段接入你的图片 API。</view></view></view>
.title{font-size:48rpx;margin:14rpx 0}.subtitle{color:#8fa7b8;margin-bottom:32rpx}.heading{font-size:28rpx;font-weight:700;margin-bottom:20rpx}.row{gap:14rpx}.row>picker,.row>input,.row>button{flex:1}.row text{flex:0}.field,input{background:#091522;color:#d9eef7;border:1rpx solid #294257;border-radius:12rpx;padding:18rpx;margin:12rpx 0;font-size:25rpx}input{min-width:0}button{margin-top:18rpx;background:#133646;color:#63e1e9;font-size:26rpx;border:1rpx solid #24546a;border-radius:14rpx}button[type=primary]{background:#168799;color:white}.muted{margin:14rpx 0}.filename{word-break:break-all;margin:18rpx 0}.preview{width:100%;height:450rpx;background:white;margin-top:20rpx}.glyph{position:fixed;left:-1000px;top:0;width:32px;height:32px}.error{color:#ff9f8d;font-size:24rpx}.status{white-space:pre-wrap}

.ota-hero{background:radial-gradient(circle at 90% 0,#3c2349 0,transparent 45%),linear-gradient(145deg,#111827,#181225)}.firmware-card{text-align:center;padding-top:42rpx}.firmware-icon{width:112rpx;height:112rpx;line-height:112rpx;margin:0 auto 22rpx;border-radius:28rpx;background:linear-gradient(145deg,#132b3d,#1c5061);border:1rpx solid #2ad7e6;color:#53ebf5;font-weight:800;letter-spacing:4rpx;box-shadow:0 0 30rpx rgba(38,211,225,.16)}.firmware-name{font-size:30rpx;font-weight:700;margin-bottom:8rpx}.firmware-card .tech-btn{margin-top:30rpx}.percent{font-size:36rpx;color:#2cdae7;font-weight:700}.progress-track{height:14rpx;background:#0a111d;border-radius:999rpx;overflow:hidden;margin:20rpx 0}.progress-fill{height:100%;background:linear-gradient(90deg,#18bdd3,#4ce1c3);box-shadow:0 0 18rpx #24cedd;transition:width .25s}.stage{font-size:24rpx;color:#91a9bb}.warning{font-size:23rpx;color:#7f91a5;line-height:1.7;text-align:center;padding:24rpx 30rpx}.danger{background:linear-gradient(135deg,#a53c66,#6e2d72)!important;border-color:#d85c98!important}
.firmware-name{font-size:28rpx}

.command-list{border:1rpx solid #213348;border-radius:18rpx;overflow:hidden}.command{height:92rpx!important;background:#111c2b!important;color:#eaf7ff!important;border-radius:0!important;border-bottom:1rpx solid #213348!important;text-align:left!important;display:flex!important;align-items:center;justify-content:space-between;padding:0 28rpx!important}.command:last-child{border-bottom:0!important}.arrow{font-size:44rpx;color:#28d7e5}.soon{font-size:22rpx;color:#71839a}.disabled-command{color:#71839a!important}.picker-field,.tech-input{height:88rpx;box-sizing:border-box;border:1rpx solid #284057;border-radius:16rpx;background:#0d1724;color:#dff8ff;padding:24rpx;margin-bottom:18rpx}.picker-field{display:flex;justify-content:space-between}.status-bar{position:sticky;bottom:20rpx;background:rgba(9,19,31,.94);border:1rpx solid #213b50;border-radius:999rpx;padding:18rpx 26rpx;color:#9db4c6;font-size:24rpx;display:flex;align-items:center;gap:12rpx}.pulse{width:12rpx;height:12rpx;border-radius:50%;background:#26d9e8;box-shadow:0 0 16rpx #26d9e8}
.clock-mode-row{min-height:92rpx;display:flex;align-items:center;justify-content:space-between;gap:24rpx}.clock-mode-row>view{flex:1}.now-btn{margin:0!important;padding:0 20rpx!important;height:58rpx!important;line-height:58rpx!important;border-radius:999rpx!important;background:#17233a!important;color:#a99cff!important;border:1rpx solid #4b417c!important;font-size:22rpx!important}.now-btn:after{border:0}.time-fields{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.time-fields>view>text{display:block;color:#7f95a7;font-size:22rpx;margin-bottom:8rpx}.time-input{width:100%;margin-bottom:0!important}.format-hint{margin-top:16rpx;color:#667d91;font-size:22rpx;line-height:1.55}
.command{font-size:27rpx!important}.tech-input,.picker-field{font-size:26rpx}.now-btn{font-size:24rpx!important}
.clock-preview-panel{overflow:hidden}.face-tag{color:#b39dff;font-size:23rpx}.face-switch{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin:22rpx 0}.face-switch button{height:66rpx!important;line-height:66rpx!important;padding:0!important;border-radius:14rpx!important;background:#101d2d!important;color:#8094aa!important;border:1rpx solid #294157!important;font-size:24rpx!important}.face-switch button.selected{background:#342b59!important;color:#eeeaff!important;border-color:#927cff!important}.clock-preview{width:100%;height:480rpx;border-radius:16rpx;background:#f6f1e5}
.refresh-setting{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:24rpx 0}.setting-title{color:#dcecf6;font-size:26rpx}.interval-input{display:flex;align-items:center;gap:10rpx;color:#93aabd;font-size:23rpx}.interval-input input{width:112rpx;height:62rpx;text-align:center;border:1rpx solid #3e3965;border-radius:14rpx;background:#101827;color:#d5ccff;font-size:26rpx}
.settings-table{margin:24rpx 0;border:1rpx solid #263d55;border-radius:16rpx;padding:0 20rpx}.settings-table .refresh-setting{margin:0;padding:22rpx 0;border-bottom:1rpx solid #263d55}.settings-table .refresh-setting:last-child{border-bottom:0}
.operation-time{color:#28d7e5;font-variant-numeric:tabular-nums}.indeterminate{height:8rpx;margin:22rpx 0;overflow:hidden;border-radius:8rpx;background:#192b3b}.indeterminate view{width:38%;height:100%;background:#28d7e5;animation:operation-slide 1.3s ease-in-out infinite}.stop-upload{background:#351d29!important;color:#ff9cad!important;border:1rpx solid #703345!important}.operation-panel{border-color:#31536a}@keyframes operation-slide{from{transform:translateX(-110%)}to{transform:translateX(270%)}}

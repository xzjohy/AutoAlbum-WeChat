<view class="page"><view class="hero"><view class="hero-title">三色日历</view><view class="hero-sub">年月日 · 星期 · 农历 · 天气与温湿度</view></view><canvas type="2d" id="calendar-canvas" class="hidden-canvas"></canvas><view class="panel"><view class="panel-title">天气城市</view><input value="{{city}}" bindinput="inputCity" placeholder="城市名称，例如 Shanghai"/><button class="tech-btn ghost" disabled="{{busy}}" bindtap="searchCity">搜索城市</button><view wx:if="{{cityError}}" class="city-error">{{cityError}}</view><button wx:for="{{places}}" wx:key="id" disabled="{{busy}}" data-index="{{index}}" bindtap="choosePlace">{{item.name}} · {{item.admin1}} {{item.country}}</button><view class="muted">天气：Open-Meteo；农历在本地计算。</view></view><view class="panel"><image wx:if="{{preview}}" src="{{preview}}" mode="widthFix" bindtap="preview"/><view class="muted">{{weatherError}}</view><view>{{status}} {{uploading ? progress + '%' : ''}}</view><button class="tech-btn ghost" disabled="{{busy}}" bindtap="generate">重新获取信息并预览</button><button class="tech-btn" disabled="{{busy || !preview}}" bindtap="upload">同步日历到墨水屏</button><button wx:if="{{uploading}}" class="tech-btn ghost" bindtap="cancel">停止当前上传</button></view></view>

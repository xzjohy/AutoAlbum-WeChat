page{min-height:100%;background:#07101a;color:#eaf7ff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",sans-serif}.page{padding:24rpx 24rpx 48rpx}.hero{position:relative;overflow:hidden;border-radius:30rpx;padding:38rpx 34rpx;margin-bottom:24rpx;border:1rpx solid #20364a;box-shadow:0 18rpx 50rpx rgba(0,0,0,.28)}.eyebrow{font-size:20rpx;letter-spacing:5rpx;color:#28d4e2;font-weight:700}.hero-title{font-size:48rpx;line-height:1.25;font-weight:800;margin-top:10rpx}.hero-sub{font-size:25rpx;color:#8fa7b8;margin-top:6rpx}.connection{display:inline-flex;align-items:center;gap:10rpx;margin-top:28rpx;padding:10rpx 16rpx;border-radius:999rpx;background:#17202d;color:#8395a7;font-size:22rpx}.connection .dot{width:12rpx;height:12rpx;border-radius:50%;background:#6f7d8b}.connection.online{background:rgba(31,205,183,.12);color:#5de8ce}.connection.online .dot{background:#34e3c5;box-shadow:0 0 14rpx #34e3c5}.panel,.card{background:linear-gradient(145deg,#111c2a,#0d1723);border:1rpx solid #1d3043;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 14rpx 36rpx rgba(0,0,0,.18)}.panel-title,.title{font-size:31rpx;font-weight:750}.muted{color:#7f95a7;font-size:24rpx;line-height:1.55}.row{display:flex;align-items:center;justify-content:space-between}.badge{font-size:22rpx;padding:9rpx 15rpx;color:#70e8ef;background:#12303e;border:1rpx solid #1c6170;border-radius:999rpx}.tech-btn,.btn{margin-top:22rpx!important;min-height:88rpx!important;border-radius:18rpx!important;background:linear-gradient(135deg,#17bcd2,#168799)!important;color:#f2feff!important;border:1rpx solid #34dce7!important;font-weight:700!important;font-size:29rpx!important;box-shadow:0 10rpx 26rpx rgba(22,187,207,.17)}.tech-btn.ghost{background:#101d2b!important;color:#63e1e9!important;border-color:#24546a!important;box-shadow:none}.tech-btn[disabled],.btn[disabled],button[disabled]{opacity:.42}.text-btn:after,.tech-btn:after,.btn:after,.action:after,.command:after,.mode-tab:after{border:0}.status{margin-top:20rpx;padding:18rpx;border-radius:14rpx;background:#0a1420;color:#8edfe4;font-size:25rpx}

/* Unified type scale: hero 46, section 30, action/body 27–28, support 24, meta 20–22. */
page{font-size:27rpx}.hero-title{font-size:46rpx}.panel-title,.title{font-size:30rpx;font-weight:700}.tech-btn,.btn{font-size:28rpx!important}button,input,picker{font-size:27rpx}
